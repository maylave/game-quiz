# --- ЭТАП 1: Сборка (Node.js) ---
# Используем стабильную версию Node 18 или 20. Node 24 может быть нестабильным.
FROM node:20-alpine AS build-stage

WORKDIR /app

# Копируем package.json и lock-файл
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем исходный код
COPY . .

# Собираем проект (Vite создаст папку dist)
RUN npm run build

# --- ЭТАП 2: Раздача (Nginx) ---
FROM nginx:stable-alpine AS production-stage

# ВАЖНО: Имя здесь должно совпадать с AS в первой строке (build-stage)
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Копируем конфиг Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]